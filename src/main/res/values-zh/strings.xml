<resources>
	<string name="app_name">女娲石Xposed</string>
	<string name="xposed_description">基于现代 libxposed API 102 增强微信与媒体通知。</string>

	<string name="settings_title">女娲石 Xposed 设置</string>
	<string name="settings_core_category">核心功能</string>
	<string name="settings_optional_category">可选增强</string>
	<string name="settings_apply_title">应用设置</string>
	<string name="settings_restart_summary">修改后请重启对应的目标进程。微信增强默认开启；可能影响系统全局通知的可选增强默认关闭。</string>

	<string name="decorators_misc_label">女娲石 - 通用插件集</string>

	<string name="decorator_elastic_inbox_title">弹性列表</string>
	<string name="decorator_elastic_inbox_description">将原本每条单行的列表式通知伸展为每条可显示多行文字，使行数较少的列表可显示更完整的内容。</string>

	<string name="decorator_stack_title">历史堆叠</string>
	<string name="decorator_stack_description">将同一个通知栏位被覆盖的历史消息以列表的形式堆叠展现。</string>

	<string name="decorator_big_text_title">多行文本</string>
	<string name="decorator_big_text_description">将单行文本扩展为可展开的多行文本，以展现超过一行被截断的完整内容。</string>

	<string name="decorator_no_sticky_title">隐藏顽固通知</string>
	<string name="decorator_no_sticky_description">隐藏无法被划掉的通知。（对通知执行延后操作可触发）</string>
	<string name="no_sticky_prompt_title">是否隐藏该顽固通知？</string>
	<string name="no_sticky_prompt_sub_text">点击隐藏</string>
	<string name="no_sticky_toast">通知已隐藏，直到下次启动。</string>

	<!-- decorator-wechat -->

	<string name="decorator_wechat_title">微信通知增强</string>
	<string name="decorator_wechat_description">符合当代 Android 的最佳通知体验：可展开的会话样式、直接回复、划除即已读等高级特性。</string>
	<string name="decorator_wechat_image_preview_title">通知内显示图片</string>
	<string name="decorator_wechat_image_preview_description">收到图片时在通知里直接显示图片，而不是 [图片]。开启或关闭后需要重启微信进程；关闭时保持微信原始的 [图片] 提示。</string>
	<string name="self_display_name">我</string>
	<string name="action_reply">回复</string>
	<string name="action_zoom">缩放</string>
	<string name="action_preview_image">预览图片</string>

	<string name="channel_message">新消息通知</string>
	<string name="channel_group_message">新群组消息通知</string>
	<string name="channel_misc">其它通知</string>



	<!-- decorator-media -->

	<string name="decorator_media_title">媒体通知增强</string>
	<string name="decorator_media_description">为媒体通知产生Android O样式的外观。</string>

