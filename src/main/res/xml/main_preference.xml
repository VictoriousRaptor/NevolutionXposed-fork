<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
	android:title="@string/settings_title">

	<PreferenceCategory
		android:title="@string/settings_core_category">
		<CheckBoxPreference 
			android:key="WeChatDecorator.enabled"
			android:defaultValue="true"
			android:summary="@string/decorator_wechat_description"
			android:title="@string/decorator_wechat_title"/>
		<CheckBoxPreference
			android:key="WeChatDecorator.show_last_reply"
			android:defaultValue="false"
			android:dependency="WeChatDecorator.enabled"
			android:summary="@string/decorator_wechat_show_last_reply_description"
			android:title="@string/decorator_wechat_show_last_reply_title"/>
		<CheckBoxPreference
			android:key="WeChatDecorator.preserve_emoji"
			android:defaultValue="false"
			android:dependency="WeChatDecorator.enabled"
			android:summary="@string/decorator_wechat_preserve_emoji_description"
			android:title="@string/decorator_wechat_preserve_emoji_title"/>
		<CheckBoxPreference
			android:key="WeChatDecorator.markdown"
			android:defaultValue="false"
			android:dependency="WeChatDecorator.enabled"
			android:summary="@string/decorator_wechat_markdown_description"
			android:title="@string/decorator_wechat_markdown_title"/>
		<CheckBoxPreference
			android:key="WeChatDecorator.image_preview"
			android:defaultValue="false"
			android:summary="@string/decorator_wechat_image_preview_description"
			android:title="@string/decorator_wechat_image_preview_title"/>
		<CheckBoxPreference
			android:key="WeChatDecorator.image_preview_large"
			android:defaultValue="false"
			android:summary="@string/decorator_wechat_image_preview_large_description"
			android:title="@string/decorator_wechat_image_preview_large_title"/>
		<EditTextPreference
			android:key="WeChatDecorator.image_preview_wait_ms"
			android:defaultValue="1500"
			android:dependency="WeChatDecorator.image_preview"
			android:dialogTitle="@string/decorator_wechat_image_wait_title"
			android:title="@string/decorator_wechat_image_wait_title"/>
	</PreferenceCategory>

	<Preference
		android:selectable="false"
		android:summary="@string/settings_restart_summary"
		android:title="@string/settings_apply_title" />

</PreferenceScreen>
